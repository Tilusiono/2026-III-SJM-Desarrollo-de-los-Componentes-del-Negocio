digraph G {graph [rankdir=LR,pad=.35,nodesep=.35,ranksep=.5,bgcolor="white",label="FLUJO DE PRÉSTAMO (REGLAS PROPUESTAS)",labelloc=t,fontsize=18,fontname="Arial"];node [fontname="Arial",fontsize=10,shape=box,style="rounded,filled",fillcolor="#EFF6FF",color="#2563EB"];edge [fontname="Arial",fontsize=10,color="#475569"]; a[label="POST /prestamos"];b[label="Validar lector ACTIVO"];c[label="Bloquear libro y validar stock > 0"];d[label="Crear préstamo PENDIENTE"];e[label="Descontar 1 ejemplar"];f[label="Confirmar transacción",fillcolor="#D1FAE5",color="#059669"];g[label="Error de negocio",fillcolor="#FEE2E2",color="#DC2626"];a->b;b->c[label="válido"];b->g[label="inválido"];c->d[label="disponible"];c->g[label="no disponible"];d->e;e->f;}