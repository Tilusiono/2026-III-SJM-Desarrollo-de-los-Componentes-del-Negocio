digraph ERD {graph [rankdir=LR, bgcolor="white",pad=.35,nodesep=.5,ranksep=.9,label="MODELO ENTIDAD-RELACIÓN · BD BIBLIOTECA",labelloc=t,fontsize=19,fontname="Arial"]; node [shape=record,fontname="Arial",fontsize=10,style="rounded,filled",fillcolor="#EFF6FF",color="#2563EB"]; edge [color="#475569",fontname="Arial",fontsize=10]; roles[label="{ROLES|PK id_rol : INT\lnombre : VARCHAR(50) [UQ]\l}"]; usuarios[label="{USUARIOS|PK id_usuario : INT\lnombre : VARCHAR(100)\lapellido : VARCHAR(100)\lemail : VARCHAR(100) [UQ]\lpassword : VARCHAR(255)\lFK id_rol : INT\l}"]; categorias[label="{CATEGORIAS|PK id_categoria : INT\lnombre : VARCHAR(100) [UQ]\ldescripcion : VARCHAR(255)\l}"]; libros[label="{LIBROS|PK id_libro : INT\lisbn : VARCHAR(20) [UQ]\ltitulo : VARCHAR(200)\lautor : VARCHAR(150)\lejemplares_disponibles : INT\lFK id_categoria : INT\l}"]; lectores[label="{LECTORES|PK id_lector : INT\ldni : VARCHAR(15) [UQ]\lnombre : VARCHAR(100)\lapellido : VARCHAR(100)\lemail : VARCHAR(100) [UQ]\ltelefono : VARCHAR(20)\lestado : ENUM\l}"]; prestamos[label="{PRESTAMOS|PK id_prestamo : INT\lFK id_lector : INT\lFK id_libro : INT\lFK id_usuario : INT\lfecha_prestamo : DATE\lfecha_devolucion_pactada : DATE\lfecha_devolucion_real : DATE\lestado : ENUM\l}",fillcolor="#FEF3C7",color="#D97706"]; roles->usuarios[label="1 : N"]; categorias->libros[label="1 : N"]; lectores->prestamos[label="1 : N"]; libros->prestamos[label="1 : N"]; usuarios->prestamos[label="1 : N"]; }