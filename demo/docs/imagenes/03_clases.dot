digraph G {graph [rankdir=LR,pad=.4,nodesep=.5,ranksep=.9,bgcolor="white",label="DIAGRAMA DE CLASES JPA (PROPUESTO)",labelloc=t,fontsize=19,fontname="Arial"];node [shape=record,style="rounded,filled",fontname="Arial",fontsize=11,fillcolor="#EFF6FF",color="#2563EB"]; edge [fontname="Arial",fontsize=10,color="#475569"];categoria[label="{Categoria|Integer idCategoria\lString nombre\lString descripcion\l}"]; libro[label="{Libro|Integer idLibro\lString isbn\lString titulo\lString autor\lInteger ejemplaresDisponibles\lCategoria categoria\l}"];lector[label="{Lector|Integer idLector\lString dni\lString nombre\lString apellido\lString email\lString telefono\lEstadoLector estado\l}"];prestamo[label="{Prestamo|Integer idPrestamo\lLector lector\lLibro libro\lUsuario usuario\lLocalDate fechaPrestamo\lLocalDate fechaDevolucionPactada\lLocalDate fechaDevolucionReal\lEstadoPrestamo estado\l}",fillcolor="#FEF3C7",color="#D97706"];rol[label="{Rol|Integer idRol\lString nombre\l}"];usuario[label="{Usuario|Integer idUsuario\lString nombre\lString apellido\lString email\lString password\lRol rol\l}"];categoria->libro[label="1 → 0..*"];rol->usuario[label="1 → 0..*"];lector->prestamo[label="1 → 0..*"];libro->prestamo[label="1 → 0..*"];usuario->prestamo[label="1 → 0..*"]; }